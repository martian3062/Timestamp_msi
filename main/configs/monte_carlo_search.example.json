{
  "samples": 8,
  "random_seed": 310,
  "primary_metric": "stable_score",
  "metric_direction": "max",
  "rank_formula": "0.40 * mean_auroc + 0.25 * mean_auprc + 0.15 * balanced_accuracy + 0.10 * msi_h_sensitivity + 0.10 * calibration_score - 0.20 * seed_std",
  
  "data": {
    "split_type": "patient_level",
    "num_folds": [3, 5],
    "test_size": [0.15, 0.20, 0.25],
    "val_size": [0.10, 0.15, 0.20],
    "stratify_by_label": true,
    "stratify_by_site": [true, false],
    "min_slides_per_class": [10, 20, 30],
    "class_balance_strategy": ["weighted_loss", "weighted_sampler", "none"],
    "label_noise_filter": [true, false],
    "duplicate_patient_policy": ["keep_first", "merge", "exclude"]
  },
  
  "tiling": {
    "magnification": ["5x", "10x", "20x", "40x"],
    "tile_size": [224, 256, 384, 512],
    "stride": ["tile_size", "tile_size/2"],
    "overlap": [0.0, 0.25, 0.5],
    "mpp": [0.25, 0.50, 1.0],
    "max_tiles_per_slide": [500, 1000, 2000, 5000],
    "min_tiles_per_slide": [50, 100, 200],
    "tissue_threshold": [0.40, 0.50, 0.60, 0.70],
    "background_threshold": [0.70, 0.80, 0.90],
    "blur_threshold": [50, 100, 150],
    "saturation_threshold": [5, 10, 15],
    "artifact_filter": [true, false],
    "pen_mark_filter": [true, false],
    "save_tiles": false,
    "save_tile_index": true
  },
  
  "feature_extraction": {
    "encoder_name": ["UNI", "Virchow", "CTransPath", "PLIP", "H-optimus", "CONCH"],
    "input_size": [224, 256, 384],
    "batch_size": [16, 32, 64],
    "normalize_features": [true, false],
    "feature_dtype": ["float16", "float32"],
    "feature_pooling_before_mil": ["none", "mean", "topk"],
    "cache_features": true,
    "freeze_encoder": true,
    "fine_tune_last_layers": false,
    "num_workers": [2, 4, 6],
    "prefetch_factor": [2, 4]
  },
  
  "bagging": {
    "bag_size": [128, 256, 512, 1024, 2048],
    "bag_sampling": ["random", "topk_attention", "balanced_random", "uncertainty_topk"],
    "bags_per_slide": [1, 2, 4, 8],
    "positive_tile_boost": [true, false],
    "tile_dropout": [0.0, 0.05, 0.10, 0.20],
    "min_bag_size": [64, 128, 256],
    "replace_sampling": [true, false],
    "hard_tile_mining": [false, true],
    "attention_topk": [64, 128, 256],
    "multi_scale_bagging": [false, true]
  },
  
  "model": {
    "mil_type": ["attention_mil", "gated_attention_mil", "transformer_mil", "clam_sb", "clam_mb"],
    "input_dim": [768, 1024, 1280, 1536, 2560],
    "hidden_dim": [128, 256, 512, 768],
    "attention_dim": [128, 256, 512],
    "num_attention_heads": [1, 2, 4, 8],
    "num_transformer_layers": [1, 2, 4],
    "mlp_layers": [1, 2, 3],
    "activation": ["relu", "gelu", "silu"],
    "dropout": [0.0, 0.10, 0.20, 0.30, 0.50],
    "attention_dropout": [0.0, 0.10, 0.20],
    "classifier_dropout": [0.10, 0.20, 0.30],
    "use_layernorm": [true, false],
    "use_batchnorm": [true, false],
    "pooling": ["attention", "mean", "max", "mean_max", "topk_attention"],
    "num_classes": 2,
    "label_smoothing": [0.0, 0.05, 0.10]
  },
  
  "loss": {
    "name": ["cross_entropy", "weighted_cross_entropy", "focal_loss", "bce_with_logits"],
    "class_weight_msi_h": [1.0, 1.5, 2.0, 3.0, 5.0],
    "class_weight_mss": 1.0,
    "focal_gamma": [1.0, 2.0, 3.0],
    "focal_alpha": [0.25, 0.50, 0.75],
    "label_smoothing": [0.0, 0.05, 0.10],
    "pos_weight": "class imbalance ratio",
    "loss_reduction": "mean"
  },
  
  "optimizer": {
    "name": ["adamw", "adam", "sgd", "lion"],
    "learning_rate_min": 1e-5,
    "learning_rate_max": 3e-3,
    "weight_decay_min": 1e-6,
    "weight_decay_max": 1e-2,
    "gradient_clip_val": [0.5, 1.0, 2.0, 5.0]
  },
  
  "scheduler": {
    "name": ["cosine", "onecycle", "reduce_on_plateau", "none"],
    "warmup_epochs": [0, 1, 3, 5],
    "min_lr": [1e-7, 1e-6, 1e-5],
    "patience": [3, 5, 8]
  },
  
  "trainer": {
    "max_epochs": [20, 30, 50, 80],
    "batch_size": [1, 2, 4, 8],
    "accumulate_grad_batches": [1, 2, 4, 8],
    "precision": ["16-mixed", "bf16-mixed", "32"],
    "seed_choices": [310, 42, 123, 2026, 777],
    "early_stopping_patience": [5, 8, 10],
    "monitor_metric": ["val_auroc", "val_auprc", "stable_score"]
  },
  
  "augmentation": {
    "horizontal_flip_p": 0.5,
    "vertical_flip_p": 0.5,
    "rotate_p": [0.25, 0.50],
    "color_jitter_p": [0.25, 0.50],
    "brightness": [0.05, 0.10, 0.20],
    "contrast": [0.05, 0.10, 0.20],
    "stain_augmentation": [false, true]
  },
  
  "validation": {
    "threshold_method": ["0.5", "youden_j", "max_f1", "fixed_sensitivity"],
    "bootstrap_samples": [500, 1000, 2000],
    "confidence_level": 0.95,
    "calibration_method": ["none", "temperature_scaling", "isotonic"],
    "primary_metric": ["AUROC", "AUPRC", "balanced_accuracy"]
  },
  
  "monte_carlo": {
    "mc_dropout_enabled": true,
    "mc_dropout_rate": [0.10, 0.20, 0.30, 0.50],
    "mc_samples": [20, 30, 50, 100],
    "seed_values": [310, 42, 123, 2026, 777],
    "bootstrap_ci_samples": [500, 1000, 2000],
    "stable_best_penalty": [0.25, 0.5, 1.0]
  },
  
  "optuna": {
    "n_trials_phase_1": 20,
    "n_trials_phase_2": 50,
    "timeout_hours": 8,
    "pruning": true,
    "pruner": "median",
    "sampler": "tpe"
  },
  
  "n8n": {
    "batch_size_svs": [5, 10, 15],
    "max_parallel_trials": [1, 2],
    "status_poll_interval_min": [5, 10, 15],
    "retry_count": [2, 3],
    "cleanup_after_success": true,
    "cleanup_raw_svs": true,
    "minimum_free_storage_gb": [20, 25, 30]
  }
}
